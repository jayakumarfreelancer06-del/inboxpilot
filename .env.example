# --- Required ---
GEMINI_API_KEY=
# Google OAuth client (Web application). Authorized redirect URI:
#   http://localhost:3002/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generated by `make setup`
AUTH_SECRET=
APP_JWT_SECRET=

# --- Optional ---
LLM_MODEL=gemini-2.5-flash
CONFIDENCE_THRESHOLD=0.7
# mock (default, reads data/inbox/) or gmail (see README)
INBOX_MODE=mock
# Langfuse tracing (cloud.langfuse.com or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# WhatsApp via Twilio sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
PUBLIC_BASE_URL=
# Restrict who can sign in (comma-separated)
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
